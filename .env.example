# Bridge Service
BRIDGE_WS_PORT=9092
BRIDGE_PUBLIC_HOST=127.0.0.1

# Voice Application (Fonoster VoiceServer listener)
VOICE_SERVER_PORT=50061

# Coze
COZE_BOT_ID=YOUR_COZE_BOT_ID
COZE_ACCESS_TOKEN=YOUR_COZE_ACCESS_TOKEN
# 若 Coze 需要特定音频格式/事件握手，请根据官方文档设置附加参数

# Fonoster SDK 访问配置（示例，按需调整为你环境的实际变量）
FONOSTER_ENDPOINT=http://127.0.0.1:3000
FONOSTER_ACCESS_KEY_ID=YOUR_FONOSTER_ACCESS_KEY_ID
FONOSTER_ACCESS_KEY_SECRET=YOUR_FONOSTER_ACCESS_KEY_SECRET
# 或使用 TOKEN 方式（若使用）
# FONOSTER_AUTH_TOKEN=YOUR_FONOSTER_AUTH_TOKEN
